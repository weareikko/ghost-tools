{
  "name": "@ikko-dev/ghost-mcp",
  "version": "0.1.1",
  "description": "MCP server for Ghost CMS — stdio + Streamable HTTP, read/write tool split",
  "keywords": [
    "ai",
    "claude",
    "cms",
    "ghost",
    "http",
    "mcp",
    "model-context-protocol",
    "remote"
  ],
  "license": "MIT",
  "author": "ikko",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikko-dev/ghost-tools",
    "directory": "packages/mcp"
  },
  "bin": {
    "ghost-mcp": "./dist/index.js",
    "ghost-mcp-server": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ikko-dev/ghost-api": "*",
    "@ikko-dev/ghost-core": "*",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "h3": "^2.0.1-rc.22"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
