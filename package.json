{
  "name": "@ikko-dev/ghost-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Ghost CMS tools - SDK and MCP server for AI agents and humans",
  "keywords": [
    "ai-agent",
    "api",
    "automation",
    "blog",
    "ghost",
    "mcp",
    "model-context-protocol",
    "cms"
  ],
  "license": "MIT",
  "author": "ikko",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikko-dev/ghost-tools"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w @ikko-dev/ghost-api && (npm run build -w @ikko-dev/ghost-core & npm run build -w @ikko-dev/ghost-sdk & wait) && npm run build -w @ikko-dev/ghost-mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "0.36.0",
    "oxlint": "1.51.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
